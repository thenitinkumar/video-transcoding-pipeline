# ── AWS ──────────────────────────────────────────────────────────────────────
# In production (ECS Fargate) leave these blank — the task IAM role is used.
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# For local development with LocalStack only:
# AWS_ENDPOINT_URL=http://localhost:4566

# ── S3 Buckets ────────────────────────────────────────────────────────────────
RAW_BUCKET=video-pipeline-raw
PROCESSED_BUCKET=video-pipeline-processed

# ── SQS ───────────────────────────────────────────────────────────────────────
SQS_QUEUE_URL=https://sqs.us-east-1.amazonaws.com/123456789012/vidpipe-prod-processing

# ── Database (API only) ───────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://user:password@your-rds-host:5432/video_pipeline

# ── App Security ──────────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
INTERNAL_API_KEY=replace-with-a-strong-random-value

# ── Worker → API ──────────────────────────────────────────────────────────────
API_BASE_URL=http://your-alb-dns-name.us-east-1.elb.amazonaws.com

# ── FFmpeg (worker, optional overrides) ───────────────────────────────────────
OUTPUT_CRF=23
OUTPUT_PRESET=medium
OUTPUT_AUDIO_BITRATE=128k
